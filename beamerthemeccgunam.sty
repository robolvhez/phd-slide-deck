%% General slide footer %%
\setbeamertemplate{footline}{%
  %%% \noindent\hspace{\titlehmargin}\rule{\dimexpr\fullpagewidth-\titlehmargin*2\relax}{0.4pt}\par%
  \vspace{\titlevmargin}%
  \leavevmode%
  \noindent\hspace{\dimexpr\titlehmargin-\titlevmargin\relax}%
  \begin{beamercolorbox}[sep=\titlevmargin,wd=\dimexpr\fullpagewidth-\titlehmargin*2+\titlevmargin*2\relax]{footline}%
    % --- Institution Logo ---
%%%    \begin{minipage}{\dimexpr\ccglogowidth+1pt\relax}%
%%%      \includegraphics[width=\ccglogowidth]{img/ccg-logo.png}%
%%%    \end{minipage}%
%%%    \hfill%
    % --- Title ---
    {\usebeamercolor[fg]{title in head/foot}\usebeamerfont{title in head/foot}\insertshorttitle}%
    \hfill%
    % --- Date ---
    {\usebeamercolor[fg]{date in head/foot}\usebeamerfont{date in head/foot}\insertshortdate{}}%
    \hfill%
    % --- Slide number ---
    {\usebeamercolor[fg]{page number in head/foot}\usebeamerfont{page number in head/foot}\usebeamertemplate{page number in head/foot}}%
  \end{beamercolorbox}
  \vspace{\titlevmargin}%
}

% Biblatex format
\renewbibmacro*{cite}{%
  \iffieldundef{shorthand}
    {\ifthenelse{\ifnameundef{labelname}\OR\iffieldundef{labelyear}}
       {\usebibmacro{cite:label}%
        \setunit{\printdelim{nonameyeardelim}}}
       {\printnames{labelname}%
        \setunit{\printdelim{nameyeardelim}}}%
     \usebibmacro{cite:labeldate+extradate}%
     \setunit{\addcomma\space}%
     \usebibmacro{journal}}
    {\usebibmacro{cite:shorthand}}}

% ============================================================
% Card Commands
% ============================================================
% For either function, it goes like this:
%
% Usage:
%   \tutorcard{<image path>}{<circle radius>}{<name>}{<role>}{<affiliation>}
%
% Example:
%   \collabcard{img/tutors/mashaal-sohail.jpeg}{1.1cm}
%     {PhD. Mashaal Sohail}{Main PhD Supervisor}{CCG -- UNAM}
% ============================================================
\newcommand{\tutorcard}[5]{%
  \begin{minipage}[t]{0.31\textwidth}%
    \centering
    \begin{tikzpicture}
      \clip (0,0) circle (#2);
      \node[anchor=center] at (0,0)
        {\includegraphics[width=\dimexpr 2\dimexpr #2\relax\relax, height=\dimexpr 2\dimexpr #2\relax\relax]{#1}};
    \end{tikzpicture}\\[1pt]
    {
        \sffamily
        \color{ccgblue!50!black}
        {\scriptsize\bfseries #3}\\[-5pt]
        {\tiny #4}\\[-5pt]
        {\tiny #5}
    }
  \end{minipage}%
}
\newcommand{\collabcard}[5]{%
  \begin{minipage}[t]{0.45\textwidth}%
    \centering
    \begin{tikzpicture}
      \clip (0,0) circle (#2);
      \node[anchor=center] at (0,0)
        {\includegraphics[width=\dimexpr 2\dimexpr #2\relax\relax, height=\dimexpr 2\dimexpr #2\relax\relax]{#1}};
    \end{tikzpicture}\\[1pt]
    {
      \sffamily
      {\color{ccgblue!50!black}
        {\scriptsize\bfseries #3}\\[-2pt]
      }
      {\tiny #4}\\[-5pt]
      {\tiny #5}
    }
  \end{minipage}%
}

