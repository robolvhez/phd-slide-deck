@article{durietz2024contribution,
  title = {The Contribution of Attention-Deficit/Hyperactivity Disorder Polygenic Load to Metabolic and Cardiovascular Health Outcomes: {{A}} Large-Scale Population and Sibling Study},
  author = {Du Rietz, E. and Xie, T. and Wang, R. and Cheesman, R.},
  date = {2024},
  journaltitle = {Translational Psychiatry},
  shortjournal = {Transl. Psychiatry},
  volume = {14},
