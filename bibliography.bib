@article{venkateswaran2024-gwas-mexico,
  title = {Polygenic Scores for Tobacco Use Provide Insights into Systemic Health Risks in a Diverse {{EHR-linked}} Biobank in {{Los Angeles}}},
  author = {Venkateswaran, Vidhya and Boulier, Kristin and Ding, Yi and Johnson, Ruth and Bhattacharya, Arjun and Pasaniuc, Bogdan},
  date = {2024-01-18},
  journaltitle = {Translational Psychiatry},
  shortjournal = {Transl. Psychiatry},
  volume = {14},
  number = {1},
  pages = {38},
  publisher = {Nature Publishing Group},
  issn = {2158-3188},
  doi = {10.1038/s41398-024-02743-z},
  url = {https://www.nature.com/articles/s41398-024-02743-z},
  urldate = {2026-06-18},
  abstract = {Tobacco use is a major risk factor for many diseases and is heavily influenced by environmental factors with significant underlying genetic contributions. Here, we evaluated the predictive performance, risk stratification, and potential systemic health effects of tobacco use disorder (TUD) predisposing germline variants using a European- ancestry-derived polygenic score (PGS) in 24,202 participants from the multi-ancestry, hospital-based UCLA ATLAS biobank. Among genetically inferred ancestry groups (GIAs), TUD-PGS was significantly associated with TUD in European American (EA) (OR: 1.20, CI: [1.16, 1.24]), Hispanic/Latin American (HL) (OR:1.19, CI: [1.11, 1.28]), and East Asian American (EAA) (OR: 1.18, CI: [1.06, 1.31]) GIAs but not in African American (AA) GIA (OR: 1.04, CI: [0.93, 1.17]). Similarly, TUD-PGS offered strong risk stratification across PGS quantiles in EA and HL GIAs and inconsistently in EAA and AA GIAs. In a cross-ancestry phenome-wide association meta-analysis, TUD-PGS was associated with cardiometabolic, respiratory, and psychiatric phecodes (17 phecodes at P\,{$<$}\,2.7E-05). In individuals with no history of smoking, the top TUD-PGS associations with obesity and alcohol-related disorders (P\,=\,3.54E-07, 1.61E-06) persist. Mendelian Randomization (MR) analysis provides evidence of a causal association between adiposity measures and tobacco use. Inconsistent predictive performance of the TUD-PGS across GIAs motivates the inclusion of multiple ancestry populations at all levels of genetic research of tobacco use for equitable clinical translation of TUD-PGS. Phenome associations suggest that TUD-predisposed individuals may require comprehensive tobacco use prevention and management approaches to address underlying addictive tendencies.},
  langid = {english},
  keywords = {gwas-mexico},
  file = {/home/rolvhdez/Documents/reading/articles_local/zotero/venkateswaran2024-gwas-mexico.pdf;/home/rolvhdez/Zotero/storage/ZYJEYQMI/venkateswaran2024-addiction.pdf}
}

@article{villa-islas2023-,
  title = {Demographic History and Genetic Structure in Pre-{{Hispanic Central Mexico}}},
  author = {Villa-Islas, Viridiana and Izarraras-Gomez, Alan and Larena, Maximilian and Mejía Perez Campos, Elizabeth and Sandoval-Velasco, Marcela and Rodríguez-Rodríguez, Juan Esteban and Bravo-Lopez, Miriam and Moguel, Barbara and Fregel, Rosa and Garfias-Morales, Ernesto and Medina Tretmanis, Jazeps and Velázquez-Ramírez, David Alberto and Herrera-Muñóz, Alberto and Sandoval, Karla and Nieves-Colón, Maria A. and García Moreno, Gabriela Zepeda and Villanea, Fernando A and Villanueva Medina, Eugenia Fernández and Aguayo-Haro, Ramiro and Valdiosera, Cristina and Ioannidis, Alexander G. and Moreno-Estrada, Andrés and Jay, Flora and Huerta-Sanchez, Emilia and Moreno-Mayar, J. Víctor and Sánchez-Quinto, Federico and Ávila-Arcos, María C.},
  date = {2023-05-12},
  journaltitle = {Science (New York, N.Y.)},
  shortjournal = {Science},
  volume = {380},
  number = {6645},
  eprint = {37167382},
  eprinttype = {pubmed},
  pages = {eadd6142},
  issn = {0036-8075},
  doi = {10.1126/science.add6142},
  url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC12087575/},
  urldate = {2025-10-28},
  abstract = {Aridoamerica and Mesoamerica are two distinct cultural areas in northern and central Mexico, respectively, that hosted numerous pre-Hispanic civilizations between 2,500 BCE and 1,521 CE. The division between these regions shifted southward due to severe droughts ca. 1,100 years ago, allegedly driving a population replacement in central Mexico by Aridoamerican peoples. Here, we present shotgun genome-wide data from 12 individuals and 27 mitochondrial genomes from eight pre-Hispanic archaeological sites across Mexico, including two at the shifting border of Aridoamerica and Mesoamerica. We find population continuity spanning the climate change episode and a broad preservation of the genetic structure across present-day Mexico for the last 2,300 years. Lastly, we identify a contribution to pre-Hispanic populations of northern and central Mexico from two ancient unsampled ‘ghost’ populations.},
  pmcid = {PMC12087575}
}

