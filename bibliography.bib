, Caleb and Lanzagorta, Nuria and Lima, Monicke O. and Longhurst, Melanie O. and Lozada Martinez, David A. and Luna, Elba S. and Marques, Andrea H. and Martinez, Molly S. and family=Los Angeles Matos, given=Maria, prefix=de, useprefix=true and Maye, Caitlyn E. and McGuire, Joseph F. and Menezes, Gabriela and Minaya, Charlene and Miño, Tomás and Mithani, Sara M. and family=Oca, given=Circe Montes, prefix=de, useprefix=true and Morales-Rivero, Alonso and Moreira-de-Oliveira, Maria E. and Morris, Olivia J. and Muñoz, Sandra I. and Naqqash, Zainab and Núñez Bracho, Ambar A. and Núñez Bracho, Belinda E. and Rojas, Maria Corina Ochoa and Olavarria Castaman, Luis A. and Balmaceda, Trinidad Olivos and Ortega, Iliana and Patel, Darpan I. and Patrick, Ainsley K. and Paz y Mino, Mariel and Perales Orellana, Jose L. and Stumpf, Bárbara Perdigão and Peregrina, Tamara and Duarte, Tania Pérez and Piacsek, Kelly L. and Placencia, Maritza and Prieto, María Belén and Quarantini, Lucas C. and Quarantini-Alvim, Yana and Ramos, Renato T. and Ramos, Iaroslava C. and Ramos, Vanessa R. and Ramsey, Kesley A. and Ray, Elise V. and Richter, Margaret A. and Riemann, Bradley C. and Rivas, Juan C. and Rosario, Maria C. and Ruggero, Camilo J. and Ruiz-Chow, Angel A. and Ruiz-Velasco, Alejandra and Sagarnaga, Melisa N. and Sampaio, Aline S. and Saraiva, Leonardo C. and Schachar, Russell J. and Schneider, Sophie C. and Schweissing, Ethan J. and Seligman, Laura D. and Shavitt, Roseli G. and Soileau, Keaton J. and Stewart, S. Evelyn and Storch, Shaina B. and Strouphauer, Emily R. and Cuevas, Vissente Tapia and Timpano, Kiara R. and family=Garza, given=Beatriz Treviño-de, prefix=la, useprefix=true and Vallejo-Silva, Alexie and Vargas-Medrano, Javier and Vásquez, María I. and Martinez, Guadalupe Vidal and Weinzimmer, Saira A. and Yanez, Mauricio A. and Zai, Gwyneth and Zapata-Restrepo, Lina M. and Zappa, Luz M. and Zepeda-Burgos, Raquel M. and Zoghbi, Anthony W. and Miguel, Euripedes C. and Rodriguez, Carolyn I. and Martinez Mallen, Mayra C. and Moya, Pablo R. and Borda, Tania and Moyano, María Beatriz and Mattheisen, Manuel and Pereira, Stacey and Lázaro-Muñoz, Gabriel and Martinez-Gonzalez, Karen G. and Pato, Michele T. and Nicolini, Humberto and Storch, Eric A.},
  date = {2024},
  journaltitle = {American Journal of Medical Genetics Part B: Neuropsychiatric Genetics},
  shortjournal = {Am. J. Med. Genet. B Neuropsychiatr. Genet.},
  volume = {195},
  number = {4},
  pages = {e32962},
  issn = {1552-485X},
  doi = {10.1002/ajmg.b.32962},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/ajmg.b.32962},
  urldate = {2026-06-18},
  abstract = {Obsessive-compulsive disorder (OCD) is a debilitating psychiatric disorder. Worldwide, its prevalence is 2\% and its etiology is mostly unknown. Identifying biological factors contributing to OCD will elucidate underlying mechanisms and might contribute to improved treatment outcomes. Genomic studies of OCD are beginning to reveal long-sought risk loci, but {$>$}95\% of the cases currently in analysis are of homogenous European ancestry. If not addressed, this Eurocentric bias will result in OCD genomic findings being more accurate for individuals of European ancestry than other ancestries, thereby contributing to health disparities in potential future applications of genomics. In this study protocol paper, we describe the Latin American Trans-ancestry INitiative for OCD genomics (LATINO, https://www.latinostudy.org). LATINO is a new network of investigators from across Latin America, the United States, and Canada who have begun to collect DNA and clinical data from 5000 richly phenotyped OCD cases of Latin American ancestry in a culturally sensitive and ethical manner. In this project, we will utilize trans-ancestry genomic analyses to accelerate the identification of OCD risk loci, fine-map putative causal variants, and improve the performance of polygenic risk scores in diverse populations. We will also capitalize on rich clinical data to examine the genetics of treatment response, biologically plausible OCD subtypes, and symptom dimensions. Additionally, LATINO will help elucidate the diversity of the clinical presentations of OCD across cultures through various trainings developed and offered in collaboration with Latin American investigators. We believe this study will advance the important goal of global mental health discovery and equity.},
  langid = {english},
  keywords = {gwas-mexico},
  file = {/home/rolvhdez/Documents/reading/articles_local/zotero/crowley2024-genetic.pdf}
}

