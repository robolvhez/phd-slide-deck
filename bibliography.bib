@article{peterson2017-population-stratification,
  title = {The Utility of Empirically Assigning Ancestry Groups in Cross-Population Genetic Studies of Addiction},
  author = {Peterson, Roseann E. and Edwards, Alexis C. and Bacanu, Silviu-Alin and Dick, Danielle M. and Kendler, Kenneth S. and Webb, Bradley T.},
  date = {2017},
  journaltitle = {The American Journal on Addictions},
  shortjournal = {Am. J. Addict.},
  volume = {26},
  number = {5},
  pages = {494--501},
  issn = {1521-0391},
  doi = {10.1111/ajad.12586},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/ajad.12586},
  urldate = {2024-06-11},
  abstract = {Background and Objectives Given moderate heritability and significant heterogeneity among addiction phenotypes, successful genome-wide association studies (GWAS) are expected to need very large samples. As sample sizes grow, so can genetic diversity leading to challenges in analyzing these data. Methods for empirically assigning individuals to genetically informed ancestry groups are needed. Methods We describe a strategy for empirically assigning ancestry groups in ethnically diverse GWAS data including extensions of principal component analysis (PCA) and population matching through minimum Mahalanobis distance. We apply these methods to data from Spit for Science (S4S): the University Student Survey, a study following college students longitudinally that includes genetic and environmental data on substance use and mental health (n = 7,603). Results The genetic-based population assignments for S4S were 48.7\% European, 22.5\% African, 10.4\% Americas, 9.2\% East Asian, and 9.2\% South Asian descent. Self-reported census categories “More than one race” and “Unknown”as well as “Hawaiian/Pacific Islander” and “American-Indian/Native Alaskan” were empirically assigned representing a +9\% sample retention over conventional methods. Although there was high concordance between self-reported race and empirical population-match (+.924), there was reduction in variance for most ancestry PCs for genetic-based population assignments. Conclusions We were able to create more genetically homogenous groups and reduce sample and marker loss through cross-ancestry meta-analysis, potentially increasing power to detect etiologically relevant variation. Our approach provides a framework for empirically assigning genetic ancestry groups which can be applied to other ethnically diverse genetic studies. Scientific Significance Given the important public health impact and demonstrable gains in statistical power from studying diverse populations, empirically sound practices for genetic studies are needed. (Am J Addict 2017;26:494–501)},
  issue = {5},
  langid = {english},
  keywords = {population-stratification}
}

@article{petty2025-genome-wideassociationstudies,
  title = {Large-Scale Multi-Omics Analyses in {{Hispanic}}/{{Latino}} Populations Identify Genes for Cardiometabolic Traits},
  author = {Petty, Lauren E. and Chen, Hung-Hsin and Frankel, Elizabeth G. and Zhu, Wanying and Downie, Carolina G. and Graff, Mariaelisa and Lin, Phillip and Sharma, Priya and Zhang, Xinruo and Scartozzi, Alyssa C. and Roshani, Rashedeh and Landman, Joshua M. and Boehnke, Michael and Bowden, Donald W. and Chambers, John C. and Mahajan, Anubha and McCarthy, Mark I. and Ng, Maggie C. Y. and Sim, Xueling and Spracklen, Cassandra N. and Zhang, Weihua and Preuss, Michael and Bottinger, Erwin P. and Nadkarni, Girish N. and Loos, Ruth J. F. and Chen, Yii-Der Ida and Tan, Jingyi and Ipp, Eli and Genter, Pauline and Emery, Leslie S. and Louie, Tin and Sofer, Tamar and Stilp, Adrienne M. and Taylor, Kent D. and Xiang, Anny H. and Buchanan, Thomas A. and Roll, Kathryn and Gao, Chuan and Palmer, Nicholette D. and Norris, Jill M. and Wagenknecht, Lynne E. and Nousome, Darryl and Varma, Rohit and McKean-Cowdin, Roberta and Guo, Xiuqing and Hai, Yang and Hsueh, Willa and Sandow, Kevin and Parra, Esteban J. and Cruz, Miguel and Valladares-Salgado, Adan and Wacher-Rodarte, Niels and Rotter, Jerome I. and Goodarzi, Mark O. and Rich, Stephen S. and Bertoni, Alain and Raffel, Leslie J. and Nadler, Jerry L. and Kandeel, Fouad R. and Duggirala, Ravindranath and Blangero, John and Lehman, Donna M. and DeFronzo, Ralph A. and Thameem, Farook and Wang, Yujie and Gahagan, Sheila and Blanco, Estela and Burrows, Raquel and Huerta-Chagoya, Alicia and Florez, Jose C. and Tusie-Luna, Teresa and González-Villalpando, Clicerio and Orozco, Lorena and Haiman, Christopher A. and Hanis, Craig L. and Rohde, Rebecca and Whitsel, Eric A. and Reiner, Alexander P. and Kooperberg, Charles and Li, Yun and Duan, Qing and Lee, Miryoung and Correa-Burrows, Paulina and Fried, Susan K. and North, Kari E. and McCormick, Joseph B. and Fisher-Hoch, Susan P. and Gamazon, Eric R. and Morris, Andrew P. and Mercader, Josep M. and Highland, Heather M. and Below, Jennifer E.},
  date = {2025-04-11},
  journaltitle = {Nature Communications},
  shortjournal = {Nat. Commun.},
  volume = {16},
  number = {1},
  pages = {3438},
  publisher = {Nature Publishing Group},
  issn = {2041-1723},
  doi = {10.1038/s41467-025-58574-z},
  url = {https://www.nature.com/articles/s41467-025-58574-z},
  urldate = {2025-06-28},
  abstract = {Here, we present a multi-omics study of type 2 diabetes and quantitative blood lipid and lipoprotein traits conducted to date in Hispanic/Latino populations (nmax\,=\,63,184). We conduct a meta-analysis of 16 type 2 diabetes and 19 lipid trait GWAS, identifying 20 genome-wide significant loci for type 2 diabetes, including one novel locus and novel signals at two known loci, based on fine-mapping. We also identify sixty-one genome-wide significant loci across the lipid/lipoprotein traits, including nine novel loci, and novel signals at 19 known loci through fine-mapping. Next, we analyze genetically regulated expression, perform Mendelian randomization, and analyze association with transcriptomic and proteomic measure using multi-omics data from a Hispanic/Latino population. Using this approach, we identify genes linked to type 2 diabetes and lipid/lipoprotein traits, including TMEM205 and NEDD9 for HDL cholesterol, TREH for triglycerides, and ANXA4 for type 2 diabetes.},
  langid = {english},
  keywords = {Genome-wide association studies,Proteomics},
  file = {/home/rolvhdez/Documents/reading/articles_local/zotero/petty2025-genome-wideassociationstudies.pdf}
}

