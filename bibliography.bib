@article{lerga-jaso2025-populationgenetics,
  title = {Tracing Human Genetic Histories and Natural Selection with Precise Local Ancestry Inference},
  author = {Lerga-Jaso, Jon and Novković, Biljana and Unnikrishnan, Deepu and Bamunusinghe, Varuna and Hatorangan, Marcelinus R. and Manson, Charlie and Pedersen, Haley and Osama, Alex and Terpolovsky, Andrew and Bohn, Sandra and De Marino, Adriano and Mahmoud, Abdallah A. and Bircan, Karatuğ O. and Khan, Umar and Grabherr, Manfred G. and Yazdi, Puya G.},
  date = {2025-05-16},
  journaltitle = {Nature Communications},
  shortjournal = {Nat. Commun.},
  volume = {16},
  number = {1},
  pages = {4576},
  publisher = {Nature Publishing Group},
  issn = {2041-1723},
  doi = {10.1038/s41467-025-59936-3},
  url = {https://www.nature.com/articles/s41467-025-59936-3},
  urldate = {2026-05-19},
  abstract = {Local ancestry inference is crucial for unraveling demographic histories, discovering selection signals, and including admixed individuals in genomic studies for improved equity and portability. To date, the precision and resolution of local ancestry inference were limited by technical and dataset issues. To address them, we present Orchestra, a model we train on over 10,000 single-origin individuals from 35 worldwide populations that demonstrates superior accuracy in benchmarking analyzes. We employ Orchestra to shed light on the demographic history of Latin Americans, finding trace ancestries supported by historical records. We then deploy it to offer insight on the debated Ashkenazi Jewish origins, highlighting their South European heritage. Finally, Orchestra enables us to map selection signatures, identifying trace Scandinavian ancestry in British samples and unveiling an immune-rich region linked to respiratory infections passed down from the Viking conquests. Our work significantly advances the field of local ancestry inference, highlighting its use in admixed populations.},
  langid = {english},
  keywords = {Evolution,Genomics,Population genetics},
  file = {/home/rolvhdez/Documents/reading/articles_local/zotero/lerga-jaso2025-populationgenetics.pdf}
}

