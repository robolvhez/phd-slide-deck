@article{palma-martinez2025-genetic-diversity,
  title = {Evolution, Genetic Diversity, and Health},
  author = {Palma-Martínez, María J. and Posadas-García, Yuridia S. and Shaukat, Amara and López-Ángeles, Brenda E. and Sohail, Mashaal},
  date = {2025-03},
  journaltitle = {Nature Medicine},
  shortjournal = {Nat. Med.},
  volume = {31},
  number = {3},
  pages = {751--761},
  publisher = {Nature Publishing Group},
  issn = {1546-170X},
  doi = {10.1038/s41591-025-03558-1},
  url = {https://www.nature.com/articles/s41591-025-03558-1},
  urldate = {2025-10-02},
  abstract = {Human genetic diversity in today’s world has been shaped by evolutionary history, demographic shifts and environmental exposures, influencing complex traits, disease susceptibility and drug responses. Capturing this diversity is essential for advancing precision medicine and promoting equitable healthcare. Despite the great progress achieved with initiatives such as the human Pangenome and large biobanks that aim for a better representation of human diversity, important challenges remain. In this Perspective, we discuss the importance of diversity in clinical genomics through an evolutionary lens. We highlight progress and challenges and outline key clinical applications of diverse genetic data. We argue that diversifying both datasets and methodologies—integrating ancestral and environmental factors—is crucial for fully understanding the genetic basis of human health and disease.},
  langid = {english},
  keywords = {genetic-diversity},
  file = {/home/rolvhdez/Documents/reading/articles_local/zotero/palma-martinez2025-genetic-diversity.pdf}
}

