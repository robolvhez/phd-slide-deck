  author = {Turner, Michael and Kuri-Morales, Pablo and Alegre-Díaz, Jesús and Baca, Paulina and Garcilazo-Ávila, Jose Adrián and González-Carballo, Carlos and Ramirez-Reyes, Raul and Rivas, Fernando and Aguilar-Ramírez, Diego and Bragg, Fiona and Gnatiuc Friedrichs, Louisa and Herrington, William G. and Hill, Michael and Trichia, Eirini and Vergara-Lope, Alejandra and Wade, Rachel and Zhu, Doreen and Collins, Rory and Peto, Richard and Berumen, Jaime and Staplin, Natalie and Torres, Jason and Haynes, Richard and Emberson, Jonathan R. and Tapia-Conyer, Roberto},
  date = {2025-11},
